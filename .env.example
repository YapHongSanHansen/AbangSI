# ReelForge — copy to .env and fill in. PREPROD ONLY. Never commit .env.
NETWORK=preprod
X402_NETWORK=cardano:preprod
BLOCKFROST_PROJECT_ID=            # https://blockfrost.io, network Cardano Preprod
BLOCKFROST_URL=https://cardano-preprod.blockfrost.io/api/v0
FACILITATOR_URL=https://x402.preprod.dev.ecosyseng.cf-deployments.org   # hosted Cardano x402 facilitator
# LOCAL_FACILITATOR=1             # run the facilitator in-process instead (Blockfrost only, holds no keys)

# Video generation (server-side only)
HIGGSFIELD_API_KEY=               # <keyId>:<secret>  (HF_CREDENTIALS also accepted)
VIDEO_BACKEND=higgsfield          # or "mock" (no credits spent; labelled mock-* in results)
# HIGGSFIELD_MODEL=bytedance/seedance-2.5/text-to-video   # default; minimax/hailuo-2.3/standard/text-to-video is cheapest

# Sokosumi (TOKEN2049 Origins Hackathon 2026 workspace)
SOKOSUMI_API_URL=https://api.preprod.sokosumi.com
SOKOSUMI_API_KEY=                 # preprod.sokosumi.com → Developer → API keys
SOKOSUMI_WORKSPACE_ID=
SOKOSUMI_ORGANIZATION_ID=
SOKOSUMI_ORGANIZATION_SLUG=
SOKOSUMI_COWORKER_ID=             # written by: pnpm --filter @reelforge/agent sokosumi setup
SOKOSUMI_VENDOR_ID=
SOKOSUMI_COWORKER_API_KEY=        # coworker_… runtime key, written by setup (never printed)
# SOKOSUMI_PAID=0                 # execution-only rehearsal (no masumiPayment)

# Wallets (written by: pnpm --filter @reelforge/agent wallets — never printed)
SELLER_MNEMONIC=
BUYER_MNEMONIC=

# Agent
PUBLIC_BASE_URL=                  # public HTTPS URL of the agent (written into the registry NFT)
PORT=8080
PRICE_TUSDM_UNITS=1000000         # 1 tUSDM (Masumi preprod tUSDM 16a55b2a…)
PRICE_LOVELACE=5000000            # x402 tADA offer; empty disables it
MASUMI_AGENT_IDENTIFIER=          # written by: pnpm --filter @reelforge/agent register
AGENT_NAME=ReelForge