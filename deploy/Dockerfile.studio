# ReelForge Studio: site + Omniclip editor + media/project API on one origin.
FROM node:24.13.0-bookworm-slim AS build
RUN corepack enable && corepack prepare pnpm@10.34.6 --activate
WORKDIR /app
COPY pnpm-workspace.yaml pnpm-lock.yaml ./
COPY packages/web/package.json packages/web/
COPY packages/higgsfield/package.json packages/higgsfield/
COPY packages/editor/package.json packages/editor/
COPY packages/agent/package.json packages/agent/
RUN pnpm install --frozen-lockfile --filter @reelforge/web... --config.ignore-scripts=true
COPY packages/higgsfield packages/higgsfield
COPY packages/editor packages/editor
COPY packages/web packages/web
RUN pnpm --filter @reelforge/web build

FROM node:24.13.0-bookworm-slim
WORKDIR /app
COPY --from=build /app /app
RUN mkdir -p /data/media && chown -R node:node /data
USER node
WORKDIR /app/packages/web
ENV NODE_ENV=production WEB_SERVER_PORT=3001 WEB_SERVER_HOST=0.0.0.0 MEDIA_STORE_DIR=/data/media
EXPOSE 3001
HEALTHCHECK --interval=30s --timeout=5s --start-period=40s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:3001/').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "--import", "tsx", "server/src/index.ts"]