# ReelForge agent: MIP-003 API, x402 escrow routes, Sokosumi coworker runtime, settlement watcher/collector.
FROM node:24.13.0-bookworm-slim
RUN corepack enable && corepack prepare pnpm@10.34.6 --activate
WORKDIR /app
COPY pnpm-workspace.yaml pnpm-lock.yaml ./
COPY packages/agent/package.json packages/agent/
COPY packages/higgsfield/package.json packages/higgsfield/
COPY packages/web/package.json packages/web/
COPY packages/editor/package.json packages/editor/
RUN pnpm install --frozen-lockfile --filter @reelforge/agent... --config.ignore-scripts=true
COPY packages/higgsfield packages/higgsfield
COPY packages/agent packages/agent
RUN mkdir -p /app/packages/agent/data && chown -R node:node /app/packages/agent/data
USER node
WORKDIR /app/packages/agent
ENV NODE_ENV=production PORT=8080
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=40s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:8080/availability').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "--import", "tsx", "src/server.ts"]